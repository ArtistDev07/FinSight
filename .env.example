# GEMINI_API_KEY: Required for server-side Gemini AI calls (gemini-4-hydrogen).
# Configure via environment variables or AI Studio Secrets panel. Never commit real keys.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The public/hosted URL of this application (injected automatically in Cloud Run / AI Studio).
APP_URL="MY_APP_URL"

# PORT: Server listen port (default: 3000)
PORT="3000"

# FIREBASE_PROJECT_ID: Optional override for Firebase Admin SDK (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID="gen-lang-client-0419535639"

# MARKET_DATA_API_KEY: Optional external market data provider key.
# When omitted, FinSight uses the verified archived NSE historical OHLCV dataset transparently.
MARKET_DATA_API_KEY=""

# ADMIN_EMAILS / ADMIN_UIDS: Optional comma-separated server-side admin allowlists
ADMIN_EMAILS=""
ADMIN_UIDS=""
